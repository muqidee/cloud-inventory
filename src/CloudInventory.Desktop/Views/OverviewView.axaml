<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CloudInventory.Desktop.ViewModels"
             x:Class="CloudInventory.Desktop.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
    <Grid MinHeight="500">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="440"
                    Spacing="12">
            <Border Width="36"
                    Height="3"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8"
                    Background="{DynamicResource AppAccentBrush}" />
            <TextBlock Text="Choose an AWS profile to begin"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppPrimaryTextBrush}" />
            <TextBlock Text="Your inventory will appear here after a connection is active."
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
            <Button Content="Open connections"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ManageConnectionsCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Padding="16,8" />
        </StackPanel>
    </Grid>
</UserControl>
