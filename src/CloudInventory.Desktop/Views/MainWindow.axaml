<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CloudInventory.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="CloudInventory.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo.webp"
        Title="Cloud Inventory"
        Width="1360"
        Height="820"
        MinWidth="1040"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">

    <Window.Styles>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
        <Style Selector="ListBox.resource-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.resource-nav > ListBoxItem">
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.resource-nav > ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppAccentSurfaceBrush}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*">
        <Border Grid.Column="0"
                Background="{DynamicResource AppSidebarBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="64,Auto,*,Auto">
                <StackPanel Grid.Row="0"
                            Margin="16,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="11">
                    <Image Width="32"
                           Height="32"
                           Source="/Assets/logo.webp"
                           Stretch="Uniform" />
                    <TextBlock Text="Cloud Inventory"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppPrimaryTextBrush}" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Classes="section-label"
                           Text="INVENTORY"
                           Margin="20,14,20,8" />

                <ListBox Grid.Row="2"
                         Classes="resource-nav"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <Grid RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0"
                                           Text="{Binding Label}"
                                           FontSize="13"
                                           FontWeight="Medium" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Description}"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3"
                        Padding="16,13"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Border Width="8"
                                Height="8"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                            IsVisible="{Binding !ConnectionSession.IsConnected}"
                                Background="#B8C0C8" />
                        <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ConnectionSession.IsConnected}"
                            Background="#25875A" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="AWS session"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConnectionSession.SessionLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="72,*">
            <Border Grid.Row="0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="24">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentPageDescription}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <Border Padding="10,6"
                                Background="{DynamicResource AppSubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border Width="7"
                                        Height="7"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                    IsVisible="{Binding !ConnectionSession.IsConnected}"
                                        Background="#9AA5B1" />
                                <Border Width="7"
                                    Height="7"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ConnectionSession.IsConnected}"
                                    Background="#25875A" />
                                <TextBlock Text="{Binding ConnectionSession.ConnectionLabel}"
                                       FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Button Content="All regions" Padding="11,6" />
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" />
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Padding="11,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1">
                <ContentControl Margin="28,24"
                                Content="{Binding CurrentPage}" />
            </ScrollViewer>
        </Grid>
    </Grid>

</Window>
